<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sepia: maroon on parchment. No title bar; the page draws its own header under the status bar. -->
    <style name="Liyamu" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
    <color name="page">#F3EAD6</color>
    <color name="card">#FFFAEF</color>
    <color name="line">#DCCDAA</color>
    <color name="ink">#3B2A20</color>
    <color name="muted">#7D6A57</color>
    <color name="accent">#6E1C22</color>
    <color name="on_accent">#FFF8E8</color>
</resources>
